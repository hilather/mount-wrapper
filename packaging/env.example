# Optional systemd EnvironmentFile for mount-wrapper.
# Install as /etc/mount-wrapper/env (mode 0640, root:mount-wrapper recommended).
# Lines are KEY=value; comments start with #. The unit uses EnvironmentFile=-
# so this file may be absent.
#
# Extend PATH so ratarmount-rs / archiveconverter / 7z resolve for the service user:
# PATH=/usr/local/bin:/home/mount-wrapper/.local/bin:/usr/bin:/bin
#
# Escape hatch if peercred is broken (default off — do not enable in production):
# MOUNT_WRAPPER_CONTROL_ALLOW_UNAUTH=1
#
# Extra logging for serve process (engines still use ratarmount_* config keys):
# MOUNT_WRAPPER_LOG_LEVEL=DEBUG
